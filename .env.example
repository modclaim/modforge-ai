# Database Configuration
DATABASE_URL=sqlite://./modforge.db

# Redis Configuration (for rate limiting and job queue)
REDIS_URL=redis://localhost:6379

# Google Gemini AI Configuration
# Base API URL (defaults to Google Generative Language v1beta)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Primary Model (e.g., gemini-2.5-flash, gemini-3.7-flash, gemini-3.8-flash, gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-2.5-flash

# Model Cascade / Fallback list
GEMINI_MODELS=gemini-2.5-flash,gemini-3.7-flash,gemini-3.8-flash,gemini-3.1-flash-lite,gemini-2.0-flash

# Multi-Key Pool (comma-separated keys with automatic auto-swap on rate limit)
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2,your_gemini_api_key_3

# Set to true to test with mock AI responses instead of consuming API quota
USE_MOCK_AI=false

# Legacy OpenAI Configuration (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Firebase Configuration (for authentication)
FIREBASE_CONFIG=path_to_firebase_service_account.json

# Cloudflare R2 Storage Configuration (Falls back to local ./uploads if empty)
CLOUDFLARE_R2_ACCOUNT_ID=your_account_id
CLOUDFLARE_R2_API_TOKEN=your_api_token
CLOUDFLARE_R2_ACCESS_KEY_ID=your_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=modforge-files
CLOUDFLARE_R2_REGION=auto

# VirusTotal Configuration (optional)
VIRUSTOTAL_API_KEY=your_virustotal_api_key

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting Configuration
RATE_LIMIT_RPM=60
FREE_MONTHLY_JOBS=10

# Server Configuration
PORT=8080
